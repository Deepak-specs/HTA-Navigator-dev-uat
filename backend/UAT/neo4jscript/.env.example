# Copy to .env and fill in. Never commit .env.

# --- Neo4j DEV instance -------------------------------------------------
NEO4J_URI=neo4j+s://<dev-host>:7687
NEO4J_USER=<user>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=neo4j

# --- LLM: same values as BEDROCK_* in the API's config.toml -------------
BEDROCK_GATEWAY_URL=https://ai-gateway.<domain>/bedrock
BEDROCK_API_KEY=<key>
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Source: where the crawler put PDFs and meta files ------------------
# local = folders on disk (sample run), azure = blob storage
ZIN_SINK=local
ZIN_ROOT=./sample_data
AZURE_STORAGE_ACCOUNT=nlhtanavigatorukspocsa
ZIN_PDF_CONTAINER=test-1709
ZIN_JSON_CONTAINER=jsonoutput-1709
# Azure auth: `az login` locally, managed identity when deployed
# (needs "Storage Blob Data Reader" on both containers).

# --- Tuning -------------------------------------------------------------
INGEST_CONCURRENCY=2
TRANSLATE_CHUNK_CHARS=9000
MAX_SUMMARY_CHARS=300000
